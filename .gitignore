# ==============================================================================
# SECURITY: DENY BY DEFAULT
# ==============================================================================
# Ignore everything in this directory and subdirectories.
# We will explicitly allow (whitelist) only what we want to track.
/*

# ==============================================================================
# ALLOWLIST (What to Track)
# ==============================================================================

# Git configuration
!/.gitignore

# Documentation
!/GEMINI.md
!/README.md

# User Content Directories
!/skills/
!/workflows/
!/extensions/

# ==============================================================================
# GLOBAL IGNORES (Apply even inside allowed directories)
# ==============================================================================

# Dependencies
node_modules/
__pycache__/
*.pyc

# Environment & Secrets
.env
.env.*
*.secret.*
*.key
*_token.json

# OS & Editor Files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==============================================================================
# EXPLICITLY IGNORED SENSITIVE FILES (Redundant with /* but for clarity)
# ==============================================================================
# These files in the root .gemini/ folder contain sensitive authentication
# and identity data. They must NEVER be committed.
/google_account_id
/google_accounts.json
/installation_id
/mcp-oauth-tokens.json
/oauth_creds.json
/state.json
/user_id
/settings.json
/settings.json.orig

# Internal Data & Temporary Files
/antigravity/
/tmp/

.agent/