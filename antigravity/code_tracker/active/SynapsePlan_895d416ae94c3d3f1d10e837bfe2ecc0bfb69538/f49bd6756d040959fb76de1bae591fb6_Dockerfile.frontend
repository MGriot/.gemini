Ø	# Dockerfile for React Frontend

# --- Build Stage ---
FROM node:20-alpine AS build

# Set the working directory
WORKDIR /app

# Copy package.json and package-lock.json for dependency installation
COPY frontend/package*.json ./

# Install dependencies
# Using --frozen-lockfile is recommended for CI/CD to ensure reproducible builds
RUN npm ci

# Copy the rest of the frontend application code

COPY frontend/ .



# Set the API base URL for the build
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

# Build the React app for production
RUN npm run build

# --- Runtime Stage (Nginx) ---
FROM nginx:1.25-alpine

# Remove the default Nginx configuration
RUN rm /etc/nginx/conf.d/default.conf

# Copy the custom Nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy the built React app from the build stage
COPY --from=build /app/dist /usr/share/nginx/html

# Change ownership of nginx logs and cache, and create pid file with correct permissions
RUN touch /var/run/nginx.pid && \
    chown -R nginx:nginx /var/run/nginx.pid /var/cache/nginx /var/log/nginx

# Switch to the non-root user
USER nginx

# Expose port 80
EXPOSE 80

# Command to start Nginx in the foreground
CMD ["nginx", "-g", "daemon off;"]Ø	"(895d416ae94c3d3f1d10e837bfe2ecc0bfb695382Gfile:///c:/Users/Admin/Documents/Coding/SynapsePlan/Dockerfile.frontend:3file:///c:/Users/Admin/Documents/Coding/SynapsePlan